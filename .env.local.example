# Copiar a `.env.local` y rellenar. `.env.local` está en .gitignore.

# ── ERP / GestionIncidencias ────────────────────────────────────────────────
# Catálogo de productos y clientes. Se usa para sincronizar el espejo local.
ERP_BASE_URL=http://ip-del-erp:puerto
ERP_EMAIL=usuario@lainnovacion.com.do
ERP_PASSWORD=

# ── Pasarela NAV (SoapProxyNav) ─────────────────────────────────────────────
# Proxy .NET que traduce a SOAP contra el codeunit RetailWebServices. De acá
# salen el balance y el límite de crédito del cliente, y por acá se emite la
# cotización con los precios reales.
#
# Se corre en local mientras se prueba. En producción apunta al despliegue de
# La Innovación, no a localhost.
NAV_PROXY_URL=http://localhost:5000

# ── Capa de IA ──────────────────────────────────────────────────────────────
# Sin esta clave el cotizador sigue funcionando: cae al parseo determinista y
# al ranking por FTS, sin reordenamiento ni explicaciones del modelo.
ANTHROPIC_API_KEY=

# Modelo para extracción de líneas y reordenamiento de candidatos.
ANTHROPIC_MODEL=claude-sonnet-5
